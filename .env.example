# Credenciais dos serviços externos (copie para .env e preencha)
# NUNCA faça commit do arquivo .env com valores reais.

# --- Sessão e criptografia -----------------------------------------------
# Gere valores aleatórios, ex.: openssl rand -hex 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Discord Developer Portal (login) ------------------------------------
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# --- Twitch Developer Console (chat, eventos, moderação) -----------------
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/integrations/twitch/callback

# --- Banco de dados (usado apenas fora do Compose) -----------------------
DATABASE_URL=postgres://sc_app:sc_dev_password@localhost:5432/stream_command
MIGRATION_DATABASE_URL=postgres://postgres:sc_dev_postgres@localhost:5432/stream_command
