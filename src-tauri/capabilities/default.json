{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Permite que a janela principal use os comandos do OBS no processo nativo.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default"
  ],
  "remote": {
    "urls": [
      "https://*/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  }
}
